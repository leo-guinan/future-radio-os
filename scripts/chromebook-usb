#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
PYTHON="${PYTHON:-}"

usage() {
  printf '%s\n' \
    'Usage: scripts/chromebook-usb <command> [options]' \
    '' \
    'Commands:' \
    '  prepare       Create/update the Chromebook-local environment.' \
    '  doctor        Check the environment and local API routes.' \
    '  test          Run the repository test suite.' \
    '  run           Start the local API and studio.' \
    '  help          Show this help.' \
    '' \
    'run options:' \
    '  --host HOST   Bind address (default: 127.0.0.1).' \
    '  --port PORT   Bind port (default: 8000).'
}

fail() {
  printf 'chromebook-usb: %s\n' "$1" >&2
  exit 1
}

require_linux() {
  [[ "$(uname -s)" == "Linux" ]] || fail "this launcher is for the ChromeOS Linux container (Linux required)"
  case "$(uname -m)" in
    x86_64|aarch64) ;;
    *) fail "unsupported Linux architecture: $(uname -m); expected x86_64 or aarch64" ;;
  esac
}

select_python() {
  if [[ -x "$VENV/bin/python" ]]; then
    PYTHON="$VENV/bin/python"
  elif [[ -z "$PYTHON" ]] && command -v python3.11 >/dev/null 2>&1; then
    PYTHON="$(command -v python3.11)"
  elif [[ -z "$PYTHON" ]] && command -v python3 >/dev/null 2>&1; then
    PYTHON="$(command -v python3)"
  fi
  [[ -n "$PYTHON" && -x "$PYTHON" ]] || fail "Python is missing; install Python 3.11 or install uv"
}

prepare() {
  require_linux
  if command -v uv >/dev/null 2>&1; then
    if [[ ! -x "$VENV/bin/python" ]]; then
      UV_PROJECT_ENVIRONMENT="$VENV" uv venv "$VENV" --python 3.11
    fi
    UV_PROJECT_ENVIRONMENT="$VENV" uv sync --extra dev
    return
  fi

  select_python
  "$PYTHON" -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11 or newer is required"'
  if [[ ! -x "$VENV/bin/python" ]]; then
    "$PYTHON" -m venv "$VENV"
  fi
  "$VENV/bin/python" -m pip install --upgrade 'pip>=24'
  "$VENV/bin/python" -m pip install -e '.[dev]'
}

python_in_env() {
  [[ -x "$VENV/bin/python" ]] || fail "missing Chromebook environment; run: $0 prepare"
  env -u PYTHONPATH "$VENV/bin/python" "$@"
}

doctor() {
  require_linux
  [[ -x "$VENV/bin/python" ]] || fail "missing Chromebook environment; run: $0 prepare"
  bash "$ROOT/scripts/doctor"
}

test_suite() {
  python_in_env -m pytest tests -q
}

run_server() {
  local host='127.0.0.1'
  local port='8000'
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) [[ $# -ge 2 ]] || fail '--host requires a value'; host="$2"; shift 2 ;;
      --port) [[ $# -ge 2 ]] || fail '--port requires a value'; port="$2"; shift 2 ;;
      *) fail "unknown run option: $1" ;;
    esac
  done
  python_in_env -m future_radio_os.cli --host "$host" --port "$port"
}

command_name="${1:-help}"
case "$command_name" in
  prepare) prepare ;;
  doctor) doctor ;;
  test) test_suite ;;
  run) run_server "$@" ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
